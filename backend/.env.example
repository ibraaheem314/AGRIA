# Copier en backend/.env (fait automatiquement par : python scripts/dev.py env)
# Ce fichier ne contient aucune valeur secrète réelle.

# Obligatoire. « python scripts/dev.py env » en génère une aléatoire.
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire

# true uniquement en développement local
DJANGO_DEBUG=true

# Hôtes autorisés, séparés par des virgules (obligatoire si DJANGO_DEBUG=false)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Base PostgreSQL. Valeurs adaptées à la base locale créée par « python scripts/dev.py db-init ».
DB_NAME=agria
DB_USER=agria
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5444

# Inscription libre par email (true/false). À false, les comptes sont créés par commande.
AGRIA_ALLOW_SIGNUP=true

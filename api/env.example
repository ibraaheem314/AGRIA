# CONFIGURATION AGRIA - Agriculture Platform
# Copiez ce fichier en .env et remplissez avec vos vraies clés

# ============================================
# SÉCURITÉ (CRITIQUE - A CHANGER EN PRODUCTION)
# ============================================
SECRET_KEY=your_super_secret_key_here_change_in_production
DATABASE_URL=sqlite:///agria.db

# ============================================  
# APIs EXTERNES (Optionnelles - Fallback simulé si absent)
# ============================================

# OpenWeather API (Météo + Agriculture)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Assistant IA (OpenRouter)  
OPEN_ROUTER_KEY=your_openrouter_api_key_here

# Qualité de l'air
AIRVISUAL_API_KEY=your_airvisual_api_key_here

# Agriculture monitoring
AGROMONITORING_API_KEY=your_agromonitoring_api_key_here

# ============================================
# CONFIGURATION SERVEUR
# ============================================
PORT=8000
FLASK_ENV=development 
# Secrets et configuration locale : seuls les fichiers *.example sont suivis
.env
.env.*
!.env.example
*.env
!*.env.example

# Archive locale privée (anciens .env, journaux) — jamais commitée
.local-archive/

# Base de données de développement et sauvegardes locales
.devdb/
backups/

# Python
__pycache__/
*.py[cod]
.venv/
.venv-*/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
dist/
frontend/test-results/
frontend/playwright-report/
frontend/blob-report/
*.tsbuildinfo

# Journaux
*.log
npm-debug.log*

# Éditeurs et système
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp
